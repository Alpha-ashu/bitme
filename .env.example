# Production & Local Environment Configuration Template for Anaconda Park
NODE_ENV=development
PORT=4000

# Security (REQUIRED in production)
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_32_chars
ALLOWED_ORIGINS=https://your-game-domain.example.com

# Persistence & Uploads (mount persistent volume in container deployments)
SQLITE_FILE=./data/anaconda.db
AD_UPLOAD_DIR=./uploads/ads
AD_REWARD_MIN_MS=4000

# Optional Initial Super-Admin Bootstrap (or run: npm --prefix backend run create-admin)
# ADMIN_BOOTSTRAP_USERNAME=RootAdmin
# ADMIN_BOOTSTRAP_PASSWORD=ChangeMeToStrongPassword123!
# ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.example

